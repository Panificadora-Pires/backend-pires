# ============================================================
# Django
# ============================================================
DEBUG=True
SECRET_KEY=django-insecure-local-development-change-me
ALLOWED_HOSTS=localhost,127.0.0.1
FRONTEND_URLS=http://localhost:5173,http://127.0.0.1:5173

# ============================================================
# Banco de dados
# ============================================================
DATABASE_URL=sqlite:///db.sqlite3

# ============================================================
# Google Identity Services
# ============================================================
# Client ID do tipo "Aplicativo da Web".
# Nunca coloque Client Secret do Google no frontend.
GOOGLE_CLIENT_ID=
GOOGLE_TOKEN_CLOCK_SKEW_SECONDS=10

# ============================================================
# Cloudinary
# ============================================================
# Exemplo: cloudinary://API_KEY:API_SECRET@CLOUD_NAME
CLOUDINARY_URL=

# ============================================================
# Regras de negócio
# ============================================================
PEDIDO_TEMPO_LIMITE_RETIRADA_MINUTOS=15

# ============================================================
# Verificação de conta / recuperação de senha
# ============================================================
VERIFICATION_CODE_TTL_MINUTES=10
VERIFICATION_MAX_ATTEMPTS=5
VERIFICATION_RESEND_COOLDOWN_SECONDS=60

# ============================================================
# E-mail
# ============================================================
# Para desenvolvimento sem enviar mensagens reais:
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# Para testar SMTP real com Gmail, use no .env real:
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=seu-email@gmail.com
# EMAIL_HOST_PASSWORD=sua-senha-de-app
# EMAIL_USE_TLS=True
# DEFAULT_FROM_EMAIL=Pires Panificadora <seu-email@gmail.com>

DEFAULT_FROM_EMAIL=Pires Panificadora <nao-responda@example.com>
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
EMAIL_TIMEOUT=10
