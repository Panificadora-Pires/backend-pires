# ============================================================
# Django
# ============================================================

DEBUG=True

# Use apenas uma chave de desenvolvimento neste arquivo.
# A chave real de produção deve ficar no Fabroku.
SECRET_KEY=django-insecure-local-development-change-me

ALLOWED_HOSTS=localhost,127.0.0.1

# Separe múltiplas URLs com vírgula e sem espaço.
FRONTEND_URLS=http://localhost:5173,http://127.0.0.1:5173


# ============================================================
# Banco de dados
# ============================================================

# Desenvolvimento local com SQLite.
# No Fabroku, DATABASE_URL é criada automaticamente
# pelo PostgreSQL vinculado.
DATABASE_URL=sqlite:///db.sqlite3


# ============================================================
# Google Identity Services
# ============================================================

# Client ID do tipo "Aplicativo da Web".
# Não coloque Google Client Secret no frontend nem neste projeto.
GOOGLE_CLIENT_ID=


# ============================================================
# Cloudinary
# ============================================================

# Pode ficar vazio no desenvolvimento local.
# Formato de produção:
# cloudinary://API_KEY:API_SECRET@CLOUD_NAME
CLOUDINARY_URL=


# ============================================================
# Regras de negócio
# ============================================================

PEDIDO_TEMPO_LIMITE_RETIRADA_MINUTOS=15


# ============================================================
# E-mail
# ============================================================

# Em desenvolvimento, os e-mails aparecem no terminal.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

DEFAULT_FROM_EMAIL=nao-responda@pirespanificadora.com.br

EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
EMAIL_TIMEOUT=10