# EXEMPLO DE PRODUÇÃO — não coloque valores reais neste arquivo versionado.

DEBUG=False
SECRET_KEY=troque-por-uma-chave-forte

ALLOWED_HOSTS=backend-pires.class.fabricadesoftware.ifc.edu.br
FRONTEND_URLS=https://frontend-pires.vercel.app

DATABASE_URL=postgresql://USUARIO:SENHA@HOST:5432/BANCO
CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME

GOOGLE_CLIENT_ID=SEU_CLIENT_ID.apps.googleusercontent.com
GOOGLE_TOKEN_CLOCK_SKEW_SECONDS=10

EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=seu-email@example.com
EMAIL_HOST_PASSWORD=SENHA_DE_APP
EMAIL_USE_TLS=True
EMAIL_TIMEOUT=10
DEFAULT_FROM_EMAIL=Pires Panificadora <seu-email@example.com>

MERCADO_PAGO_ACCESS_TOKEN=ACCESS_TOKEN_DE_PRODUCAO
MERCADO_PAGO_WEBHOOK_SECRET=SECRET_DO_WEBHOOK_DE_PRODUCAO
MERCADO_PAGO_WEBHOOK_URL=https://backend-pires.class.fabricadesoftware.ifc.edu.br/api/pedidos/mercado_pago_webhook/
MERCADO_PAGO_API_BASE_URL=https://api.mercadopago.com
MERCADO_PAGO_TIMEOUT_SECONDS=15
MERCADO_PAGO_SANDBOX=False
PAGAMENTO_TEMPO_LIMITE_MINUTOS=45

PEDIDO_TEMPO_LIMITE_RETIRADA_MINUTOS=15

VERIFICATION_CODE_TTL_MINUTES=10
VERIFICATION_MAX_ATTEMPTS=5
VERIFICATION_RESEND_COOLDOWN_SECONDS=60

# Segurança e manutenção
# Desliga Swagger/ReDoc em produção (ligue com True só se precisar consultar a documentação).
ENABLE_API_DOCS=False
# Gere um valor longo e aleatório (ex.: python -c "import secrets; print(secrets.token_urlsafe(48))").
# Use o MESMO valor no secret MANUTENCAO_TOKEN do GitHub Actions (workflow "Expirar pedidos").
MANUTENCAO_TOKEN=gere-um-token-longo-e-aleatorio
# Cancela e reembolsa pedidos confirmados que ninguém preparou após N horas (0 = desligado).
PEDIDO_TEMPO_LIMITE_PREPARO_HORAS=0
# Limites anti-abuso do checkout.
PEDIDO_QUANTIDADE_MAXIMA_POR_ITEM=50
PEDIDO_MAXIMO_ITENS_DIFERENTES=30
PEDIDO_MAXIMO_PENDENTES_POR_USUARIO=5
# Chat por pedido: horas após retirado/cancelado em que ainda dá para enviar mensagens.
CHAT_PRAZO_APOS_ENCERRAMENTO_HORAS=24
# Tamanho máximo de cada mensagem (caracteres) e limite de envios por usuário.
CHAT_MENSAGEM_TAMANHO_MAXIMO=1000
THROTTLE_CHAT_MENSAGEM=20/min
# Chatbot de ajuda: classe que responde (regras + FAQ hoje) e limite de perguntas por usuário.
CHATBOT_PROVEDOR=chatbot.services.regras.ProvedorRegras
THROTTLE_CHATBOT=30/min
# Ative depois de confirmar que o proxy envia X-Forwarded-Proto (HTTPS).
SECURE_SSL_REDIRECT=False
SECURE_HSTS_SECONDS=0
